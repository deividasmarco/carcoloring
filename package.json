{
  "name": "neon-bay",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@expo-google-fonts/michroma": "^0.4.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.12.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-expo": "~57.0.6",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run setup:web && expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:regions": "tsx scripts/build-traced-vehicle.ts",
    "previews": "jest --testMatch \"**/scripts/previews/*.preview.ts\"",
    "setup:web": "setup-skia-web public",
    "lint": "expo lint",
    "e2e:web": "node e2e/web-studio.e2e.mjs && node e2e/web-garage.e2e.mjs && node e2e/web-premium.e2e.mjs && node e2e/web-creations.e2e.mjs",
    "trace:atlas": "tsx scripts/trace-atlas.ts",
    "check:release": "node scripts/check-release.mjs",
    "eas-build-pre-install": "node scripts/check-release.mjs",
    "build:samples": "tsx scripts/sample-previews.ts",
    "font-metrics": "node scripts/font-metrics.mjs"
  },
  "private": true,
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/jest/skiaEnvironment.js",
    "setupFiles": [
      "@shopify/react-native-skia/jestSetup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.scratch/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@shopify/react-native-skia|react-native-svg)"
    ]
  }
}
