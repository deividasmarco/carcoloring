{
  "expo": {
    "name": "Neon Bay",
    "slug": "neon-bay",
    "scheme": "neonbay",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06080E",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Neon Bay saves your painted cars to your photos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.atiduok.neonbay"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06080E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Neon Bay saves your painted cars to your photos.",
          "savePhotosPermission": "Neon Bay saves your painted cars to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#06080E"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4902df3-d82c-4ab5-ac94-b24da310e822"
      },
      "legal": {
        "privacyPolicyUrl": "",
        "termsOfUseUrl": ""
      }
    }
  }
}
